<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <org.fossify.commons.views.MyAppBarLayout android:id="@+id/nas_browser_appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/nas_browser_toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:title="@string/nas_albums" app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </org.fossify.commons.views.MyAppBarLayout>
    <ProgressBar android:id="@+id/nas_browser_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/nas_browser_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/nas_browser_settings" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:text="@string/nas_open_settings" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/nas_browser_grid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="8dp" />
</LinearLayout>
