<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="8dp" android:background="?attr/selectableItemBackground"
    android:focusable="true" android:clickable="true">
    <ImageView android:id="@+id/nas_item_image" android:layout_width="match_parent" android:layout_height="112dp"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <TextView android:id="@+id/nas_item_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="middle"
        android:textSize="14sp" />
    <TextView android:id="@+id/nas_item_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" />
</LinearLayout>
